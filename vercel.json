{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "Portfolio_Frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "Portfolio_Backend",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/docs(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/redoc(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/openapi.json(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/version",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/audio/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/resume/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/data/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(favicon\\.svg|icons\\.svg|manifest\\.webmanifest|sw\\.js|registerSW\\.js|workbox-.*\\.js|admin-pwa-.*\\.png|_redirects)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(home|profile|skills|publications|projects|contacts|resume|login|admin)(.*)",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ]
}
