{
  "version": 2,
  "buildCommand": "cd Portfolio_Frontend && npm install && npm run build",
  "outputDirectory": "Portfolio_Frontend/dist",
  "installCommand": "pip install -r requirements.txt",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/health",     "destination": "/api/index.py" },
    { "source": "/version",    "destination": "/api/index.py" },
    { "source": "/(.*)",       "destination": "/index.html"   }
  ]
}
