{
  "version": 2,
  "buildCommand": "cd Portfolio_Frontend && npm install && npm run build",
  "outputDirectory": "Portfolio_Frontend/dist",
  "installCommand": "cd Portfolio_Frontend && npm install",
  "framework": null,
  "functions": {
    "Portfolio_Backend/api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/Portfolio_Backend/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/Portfolio_Backend/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/Portfolio_Backend/api/index.py"
    },
    {
      "source": "/version",
      "destination": "/Portfolio_Backend/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
